{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogTitle": "# Changelog"
      }
    ],
    [
      "semantic-release-vsce",
      {
        "packageVsix": "dist/smart-xml-sorter.vsix",
        "publish": false
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "package.json",
          "CHANGELOG.md",
          "README.md",
          "dist/smart-xml-sorter.vsix"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}\n\nCo-authored-by: Gemini <gemini@google.com>"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "dist/smart-xml-sorter.vsix",
            "label": "VSIX Extension Package"
          }
        ]
      }
    ]
  ]
}
