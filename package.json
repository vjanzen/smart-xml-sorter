{
  "name": "smart-xml-sorter",
  "displayName": "Smart XML Sorter",
  "description": "%extension.description%",
  "version": "1.2.1",
  "icon": "icon.png",
  "publisher": "vjanzen",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Formatters",
    "Utilities"
  ],
  "scripts": {
    "vscode:prepublish": "node scripts/sync_changelog.js",
    "package": "npx @vscode/vsce package --out dist/smart-xml-sorter.vsix",
    "test": "python3 -m unittest discover -s . -p \"test_*.py\" -v"
  },
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "smart-xml-sorter.sortActiveEditor",
        "title": "%command.sortActiveEditor.title%"
      }
    ],
    "keybindings": [
      {
        "command": "smart-xml-sorter.sortActiveEditor",
        "key": "ctrl+alt+x",
        "mac": "cmd+alt+x",
        "when": "editorTextFocus && editorLangId == xml"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "smart-xml-sorter.sortActiveEditor",
          "when": "editorLangId == xml",
          "group": "1_modification"
        }
      ]
    },
    "configuration": {
      "title": "Smart XML Sorter",
      "properties": {
        "xmlSorter.indent": {
          "type": "integer",
          "default": 4,
          "description": "%config.indent.description%"
        },
        "xmlSorter.sortKeys": {
          "type": "string",
          "default": "id,name,key",
          "description": "%config.sortKeys.description%"
        },
        "xmlSorter.pythonPath": {
          "type": "string",
          "default": "",
          "description": "%config.pythonPath.description%"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vjanzen/smart-xml-sorter"
  },
  "devDependencies": {
    "semantic-release": "^24.0.0",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/release-notes-generator": "^14.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^10.0.0",
    "semantic-release-vsce": "^5.0.0"
  },
  "license": "MIT"
}
